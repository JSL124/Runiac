# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# firebase emulator exported data (admin seed for local dev)
/.firebase-emulator-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling
.vscode/

# local Android APK artifact (hosted on GitHub Releases, not committed — 145MB)
/public/runiac.apk
