# Runiac admin website — environment variables.
# Copy to .env.local and fill in. Emulator defaults are uncommented so the app
# runs against the local Firebase emulator out of the box.

# =============================================================================
# Firebase — admin console backend
# =============================================================================

# Firebase project id (defaults to runiac-fypp when unset).
FIREBASE_PROJECT_ID=runiac-fypp

# Cloud Storage bucket for the project-documents feature (defaults to
# "<FIREBASE_PROJECT_ID>.firebasestorage.app" when unset — see
# src/lib/firebase/config.ts:getFirebaseStorageBucket()).
# FIREBASE_STORAGE_BUCKET=runiac-fypp.firebasestorage.app

# --- Emulator mode (default) -------------------------------------------------
# When BOTH of these are set, the Admin SDK and the sign-in REST call target the
# local emulators — no service account or web API key is required. Start the
# emulators from this repository's root with `firebase emulators:start`.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Live mode ---------------------------------------------------------------
# Comment out the two *_EMULATOR_HOST vars above and configure these instead.
#
# Service account: EITHER inline JSON (single line, escaped newlines in
# private_key) OR a path to a credentials file.
# FIREBASE_SERVICE_ACCOUNT_KEY={"project_id":"runiac-fypp","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Identity Toolkit web API key (Firebase console > Project settings > Web API
# key). Required for email/password sign-in in live mode.
# NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key

# --- Admin bootstrap ---------------------------------------------------------
# Comma-separated emails that are treated as Platform Administrators even if
# their users/{uid}.userRole is not yet platformAdmin. Use for first login, then
# promote the real account with scripts/set-admin-role.mjs.
FIREBASE_ADMIN_EMAILS=admin@runiac.app
